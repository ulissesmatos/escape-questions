# Não roda scripts de instalação das dependências.
# O @neutralinojs/neu (só para gerar o .exe) puxa o utf-8-validate, que não traz
# binário para linux-arm64 e tentaria compilar com node-gyp (exige Python) —
# isso derrubava o build no servidor ARM do Coolify. Nada aqui precisa desses
# scripts: o esbuild usa o pacote nativo opcional e o websocket tem fallback em JS.
ignore-scripts=true
